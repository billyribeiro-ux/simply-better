# engine data cache + research record (never committed) — root only, so the
# dashboard's static/data stays trackable
/data/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# generated blotters
reports/

# secrets
.env

# dashboard
node_modules/
.svelte-kit/
dashboard/build/

# dashboard data: engine-written JSONs are ignored EXCEPT the committed
# sample set, so a fresh clone always renders
dashboard/static/data/*.json
!dashboard/static/data/summary.json
!dashboard/static/data/equity.json
!dashboard/static/data/signals.json
!dashboard/static/data/geometry.json
!dashboard/static/data/attribution.json
!dashboard/static/data/live.json
!dashboard/static/data/paper.json
!dashboard/static/data/dl_eval.json
